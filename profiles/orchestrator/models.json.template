{
  "providers": {
    "gateway": {
      "baseUrl": "https://<GATEWAY_HOST>/anthropic",
      "api": "anthropic-messages",
      "apiKey": "!security find-generic-password -ws ai-gateway-key",
      "authHeader": true,
      "compat": {
        "supportsLongCacheRetention": true
      },
      "models": [
        {
          "id": "claude-opus-5",
          "name": "Opus 5 (gateway)",
          "reasoning": true,
          "compat": { "forceAdaptiveThinking": true },
          "thinkingLevelMap": { "xhigh": "xhigh", "max": "max" },
          "input": ["text", "image"],
          "contextWindow": 1000000,
          "maxTokens": 128000,
          "cost": { "input": 5.5, "output": 27.5, "cacheRead": 0.55, "cacheWrite": 6.875 }
        },
        {
          "id": "claude-sonnet-5",
          "name": "Sonnet 5 (gateway)",
          "reasoning": true,
          "compat": { "forceAdaptiveThinking": true },
          "thinkingLevelMap": { "xhigh": "xhigh", "max": "max" },
          "input": ["text", "image"],
          "contextWindow": 1000000,
          "maxTokens": 128000,
          "cost": { "input": 2.2, "output": 11.0, "cacheRead": 0.22, "cacheWrite": 2.75 }
        },
        {
          "id": "claude-haiku-4-5",
          "name": "Haiku 4.5 (gateway)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 200000,
          "maxTokens": 32000,
          "cost": { "input": 1.1, "output": 5.5, "cacheRead": 0.11, "cacheWrite": 1.375 }
        }
      ]
    },
    "gateway-openai": {
      "baseUrl": "https://<GATEWAY_HOST>/v1",
      "api": "openai-responses",
      "apiKey": "!security find-generic-password -ws ai-gateway-key",
      "authHeader": true,
      "models": [
        {
          "id": "bedrock/gpt-5.5",
          "name": "GPT-5.5 (gateway, Bedrock)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 400000,
          "maxTokens": 128000,
          "cost": { "input": 5.5, "output": 33, "cacheRead": 0.55, "cacheWrite": 5.5 }
        },
        {
          "id": "bedrock/gpt-5.6-terra",
          "name": "GPT-5.6 Terra (gateway, Bedrock)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 400000,
          "maxTokens": 128000,
          "cost": { "input": 2.75, "output": 13, "cacheRead": 0.275, "cacheWrite": 2.75 }
        }
      ]
    }
  }
}
